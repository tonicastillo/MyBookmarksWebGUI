{
  "manifest_version": 3,
  "name": "MyBookmarks",
  "short_name": "MyBookmarks",
  "version": "1.0.0",
  "description": "Acceso rápido a tus bookmarks de MyBookmarks2026, con búsqueda difusa y caché local.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MyBookmarks",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "bm"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Abrir MyBookmarks"
    }
  },
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "mybookmarks@tonicastillo",
      "strict_min_version": "128.0"
    }
  }
}
